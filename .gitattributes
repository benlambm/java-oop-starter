# Normalize line endings so Windows and macOS students never see a diff that
# claims "every line changed." Git stores LF; each computer checks out what it
# expects. Without this, mixed-OS teams generate enormous phantom diffs.
* text=auto

*.java     text eol=lf
*.md       text eol=lf
*.json     text eol=lf
*.xml      text eol=lf
*.prefs    text eol=lf
*.txt      text eol=lf
.classpath text eol=lf
.project   text eol=lf

# Binaries: Git must never "fix" line endings inside these.
*.jar   binary
*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary
*.class binary
